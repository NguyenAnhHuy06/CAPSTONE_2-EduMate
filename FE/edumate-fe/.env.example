# --- FE (Vite) ↔ Backend (Express) ---
# Copy this file to `.env` and adjust if needed:  copy .env.example .env

# Option A (recommended for dev): LEAVE EMPTY → axios calls `/api` on the Vite origin; Vite proxies to the backend.
# VITE_API_URL=

# Option B: Call the backend directly (skip proxy; backend must run with CORS enabled).
# VITE_API_URL=http://localhost:3001

# Backend URL for the `/api` proxy (only when using Option A — VITE_API_URL empty).
VITE_PROXY_TARGET=http://localhost:3001

# Vite dev server port (default 5173). Change if the port is in use.
# VITE_DEV_PORT=5173

# Quiz grading (lecturer): production BE uses Bearer only, no `?userId=` on
# GET /quiz/attempts/:id/lecturer-review and PATCH /quiz/attempts/:id/grade — set:
# VITE_QUIZ_GRADING_SKIP_USER_QUERY=true
# (Leave empty when using mock FE/server.js which needs userId on the query.)
